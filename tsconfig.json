{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		"strict": false,
		"noImplicitAny": false,
		"allowJs": true,
		"checkJs": false,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"./*"
			]
		}
	},
	"include": [
		".astro/types.d.ts",
		"**/*",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}