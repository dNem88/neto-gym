---
/**
 * Title1 Astro Component
 * * Props:
 * @param {string} label - The small text above the heading
 * @param {string} title - The main heading text
 * @param {string} variant - The heading tag to use (h1, h2, h3, h4)
 * @param {string} theme - 'dark' or 'light'
 * @param {string} align - 'left', 'center', 'right'
 * @param {number} duration - Animation duration in seconds
 * @param {number} delay - Animation delay in seconds
 */

const {
  label,
  title,
  variant = "h4",
  theme = "dark",
  align = "left",
  duration = 0.8,
  delay = 0,
  class: className = "",
} = Astro.props;


---

<section 
  class={`title-container align-${align} ${className}`}
  data-animate="fade-in-left"
  style={`--duration: ${duration}s; --delay: ${delay}s;`}
>
  {label && (
    <p class="label">
      {label}
    </p>
  )}
  
  <h2 class={`title title-${theme} ${variant}`}>
    {title}
  </h2>
</section>

<style>
  /* Container Logic */
  .title-container {
    display: flex;
    flex-direction: column;
    width: min(100%, 600px);
    z-index: 10;
    /* Initial state for animation */
    opacity: 0;
    transform: translateX(-50px);
    transition: opacity var(--duration) ease-out, transform var(--duration) ease-out;
    transition-delay: var(--delay);
  }

  /* Triggered state */
  .title-container.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Alignment Helpers */
  .align-left { align-items: flex-start; text-align: left; }
  .align-center { align-items: center; text-align: center; }
  .align-right { align-items: flex-end; text-align: right; }

  /* Typography styling */
  .label {
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
    color: var(--primary-main-1);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }


  .title{
    z-index: 10;
    font-weight: 650 !important;
}
.title-dark{
    color: var(--secondary-dark-1) !important;
}
.title-light{
    color: white !important;
}


  
</style>

<script>
  function initInViewAnimations() {
    const observerOptions = {
      threshold: 0.2,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          // Once it animates in, we don't need to observe it anymore
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Target any container with the data-animate attribute
    document.querySelectorAll('[data-animate="fade-in-left"]').forEach((el) => {
      observer.observe(el);
    });
  }

  // Load on start
  initInViewAnimations();

  // Load after View Transition navigations
  document.addEventListener('astro:after-swap', initInViewAnimations);
</script>