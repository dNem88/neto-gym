---
const { 
  href, 
  content, 
  variant, 
  sx, 
  width, 
  type = "button", 
  disabled = false, 
  ...rest 
} = Astro.props;

const Element = type === "button" ? "a" : "button";
const className = `button5 ${variant}`;
---

<Element 
  href={href} 
  type={type !== "button" ? type : undefined}
  class={className}
  style={{ width, ...sx }}
  aria-disabled={disabled}
  disabled={disabled}
  {...rest}
>
 
  
  <div class="button-content">
    <slot name="start-icon" />
    <span class="button-text">{content}</span>
    <slot name="end-icon" />
  </div>
</Element>

<style>
/*//////////////////////////////////////////////////////////////////////////*/
    /*Button3*/
  /*//////////////////////////////////////////////////////////////////////////*/
  .button5 {
    position: relative;
    padding: 21px 40px;
    text-align: center;
    z-index: 10;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    overflow: hidden;
    border: 2px solid transparent;
    box-sizing: border-box;
    border-radius: 46px;
  }

  
.button-content{
  padding-left: 10px;
  padding-right: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
    position: relative;
    z-index: 4; /* Ensures the text is above the background span */
    color: inherit; /* Inherit text color */
  }
  .button3 > svg{
    width: 16px;
    height: 16px;
    z-index: 10;
    
  }

.primary {
      background-color: var(--primary-main-1);
      color: white; /* Primary blue color */
      
    }
    .primary > svg{
      transition: fill .3s ease;
      fill: white;
    }
.primary:hover {
      background-color: var(--secondary-main-1);
      transition: background-color .3s ease;
    }

  /*Button1Secondary*/
.secondary {
      background-color: var(--secondary-main-1);
      color: white; /* secondary blue color */
      
    }
    .secondary > svg{
      transition: fill .3s ease;
      fill: white;
    }
.secondary:hover {
      background-color: var(--primary-main-1);
      transition: background-color .3s ease;
    }
 
/*Black*/
.black {
      background-color: black;
      color: white; /* black blue color */
      
    }
    .black > svg{
      transition: fill .3s ease;
      fill: white;
    }
.black:hover {
      background-color: rgba(0, 0, 0, 0.644);
      transition: background-color .3s ease;
    }

/*White*/
.white {
      background-color: white;
      color: black; /* white blue color */
      
    }
    .white > svg{
      transition: fill .3s ease;
      fill: black;
    }
.white:hover {
      background-color: rgba(235, 235, 235, 0.644);
      transition: background-color .3s ease;
    }



</style>