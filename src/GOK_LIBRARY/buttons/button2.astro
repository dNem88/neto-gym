---
const { 
  href, 
  content, 
  variant, 
  sx, 
  width, 
  type = "button", 
  disabled = false, 
  ...rest 
} = Astro.props;

const Element = type === "button" ? "a" : "button";
const className = `button2 ${variant}`;
---

<Element 
  href={href} 
  type={type !== "button" ? type : undefined}
  class={className}
  style={{ width, ...sx }}
  aria-disabled={disabled}
  disabled={disabled}
  {...rest}
>
  <span class={`span span-${variant}`}></span>
  
  <div class="button-content">
    <slot name="start-icon" />
    <span class="button-text">{content}</span>
    <slot name="end-icon" />
  </div>
</Element>


<style>
 /*//////////////////////////////////////////////////////////////////////////*/
    /*Button2*/
  /*//////////////////////////////////////////////////////////////////////////*/
  .button2 {
    min-width: 12.5rem;
    height: 3.25rem;
    padding: 0 1.5rem;
    position: relative;
    text-align: center;
    z-index: 10;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    overflow: hidden;
    border-radius: 8px;
   
    box-sizing: border-box;
  }

 
.span{
    position: absolute;
    width: .001px;
    height: 100%;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    top: 0;
    left: 0;
    z-index: 1; /* Ensure span is behind text */
  }  
.button-content{
    position: relative;
    z-index: 4; /* Ensures the text is above the background span */
    color: inherit; /* Inherit text color */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  /*Button 1 class for all buttons*/
.primary {
      background-color: var(--secondary-dark-1);
      color: white; /* Primary blue color */
      border: 1px solid var(--secondary-dark-1); 
      transition: color 1s ease;
    }
.primary:hover {
      border-color: var(--secondary-dark-1);
      color: var(--secondary-dark-1); /* Darker blue border on hover */
      font-weight: bold;
    }
  .span-primary{
      background-color: var(--secondary-dark-1);
  }
  .primary:hover > .span-primary{
      width: 100%;
      height: 100%;
      background-color: white;
      transition: width 0.4s ease; /* Smooth expansion on hover */
    }
  .primary:not(hover) > .span-primary{
      width: .0001px;
      height: 100%;
      background-color: white;
      transition: width 0.4s ease; /* Smooth expansion on hover */
    }
  /*Button2Secondary*/
  .secondary {
    background-color: var(--primary-main-1);
    color: white; 
    border: 1px solid var(--primary-main-1);
    transition: color 1s ease;
  }
  
  .secondary:hover {
    color:var(--primary-main-1); /* Darker blue border on hover */

  }
  .span-secondary{
    background-color: var(--primary-main-1);
  }
  .secondary:hover > .span-secondary{
    width: 100%;
    height: 100%;
    background-color: white;
    transition: width 0.4s ease, ; /* Smooth expansion on hover */
  }
  .secondary:not(hover) > .span-secondary{
    width: .1px;
    height: 100%;
    background-color: transparent;
    transition: width 0.4s ease,  background-color 0.4s ease; /* Smooth expansion on hover */
  }
  /*Button Primary-reverse*/
  .primary-reverse {
    border-left: none;
    background-color: transparent;
    border: 1px solid var(--secondary-dark-1); 
    color: var(--secondary-dark-1); /* primary-reverse blue color */
    transition: color 1s ease;
    }
    
  .primary-reverse:hover {
      color:white; /* Darker blue border on hover */
      font-weight: bold;
    }
  .span-primary-reverse{
    background-color: transparent;
    }
  .primary-reverse:hover > .span-primary-reverse{
    width: calc(100% + 1px);
    height: 100%;
    background-color: var(--secondary-dark-1);
    transition: width 0.4s ease; /* Smooth expansion on hover */
    }
    .primary-reverse:not(hover) > .span-primary-reverse{
    width: .0001px;
    height: 100%;
    background-color: var(--secondary-dark-1);
    transition: width 0.4s ease; /* Smooth expansion on hover */
    }
  
  /*Button1SecondaryrReverse*/
  .secondary-reverse {
    background-color: transparent;
    color: var(--primary-main-1); 
    border: 1px solid var(--primary-main-1); 

    transition: color 1s ease;
  }
  .secondary-reverse:hover {
    color:white; /* Darker blue border on hover */
  
  }
  .span-secondary-reverse{
    background-color: transparent;
  }
  .secondary-reverse:hover > .span-secondary-reverse{
    width: 100%;
    height: 100%;
    background-color: var(--primary-main-1);
    transition: width 0.4s ease; /* Smooth expansion on hover */
  }
  .secondary-reverse:not(hover) > .span-secondary-reverse{
    width: 0.0001px;
    height: 100%;
    background-color: var(--primary-main-1);
    transition: width 0.4s ease; /* Smooth expansion on hover */
  }
  
/*Black*/
.black {
  background-color: black;
  color: white; 
  border: 1px solid white; 

  transition: color 1s ease;
}
.black:hover {
  color:black; /* Darker blue border on hover */
 border: 1px solid black; 
}
.span-black{
  background-color: transparent;
}
.black:hover > .span-black{
  width: 100%;
  height: 100%;
  background-color: white;
  transition: width 0.4s ease; /* Smooth expansion on hover */
}
.black:not(hover) > .span-black{
  width: 0.0001px;
  height: 100%;
  background-color: white;
  transition: width 0.4s ease; /* Smooth expansion on hover */
}

/*White*/
.white {
  box-sizing: border-box;
  overflow: hidden;
  background-color: white;
  color: black; 
  border: 1px solid black; 
  transition: color 1s ease;
}
.white:hover {
  color:white; /* Darker blue border on hover */
  border: 1px solid black;
}
.span-white{
  background-color: black;
  border-radius: 8px;
}
.white:hover > .span-white{
  width: 100%;
  height: 100%;
 border: 1px solid white;
  background-color: black;
  transition: width 0.4s ease; /* Smooth expansion on hover */
}
.white:not(hover) > .span-white{
  width: 0.0001px;
  height: 100%;

  background-color: black;
  transition: width 0.2s ease; /* Smooth expansion on hover */
}

  /*Button2 Transparent*/
  .transparent {
    background-color: var(--primary-main-1);
    color: black; 
    border: 1px solid var(--primary-main-1);
    transition: background-color .35s ease;
  }
  
  .transparent:hover {
    color:var(--primary-main-1); /* Darker blue border on hover */
    background-color: transparent;
  }

  

</style>