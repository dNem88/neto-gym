---
const { service, content, icon: Icon, classname, num } = Astro.props;

---

<div class={`card ${classname}`}>
  <div class="icon-container">
    {Icon && <Icon class="card-icon" />}
  </div>

  <div class="content-container">
    <p
      class={"body1 text"}
      style={{
        fontWeight: "700",
        textAlign: "left",
      }}>{service}</p
    >
    <p
      class={"body2 text"}
      style={{
        fontWeight: "450",
        textAlign: "left",
      }}>{content}</P
    >
  </div>
  
  <p class="number">{num}</p>
</div>

<style>
 .card{
  position: relative;
  border-radius: 32px;
  width: min(100%, 400px);
  min-height: 400px;
  box-sizing: border-box;
  background-color: white;
  scale: 1;
  transition: scale .5s ease, background-color .5s ease, fill .5s ease;
  display: flex;
  flex-direction: column;
  padding: 2rem;
  cursor: pointer;
  align-items: center;
  justify-content: center;
  box-shadow: 4px 4px 10px rgb(221, 221, 221);
  gap: 1rem;
}
.card-icon{
     width: 32px;
  height: 32px;
  fill: white;
}
  .icon-container{
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75px;
    height: 75px;
    border-radius: 50%;
    background-color: var(--primary-light-1);
   
  }
  .content-container{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    flex-grow: 1;
    z-index: 10;
  }

.number{
      font-size: 10rem;
      font-weight: 1000;
      position: absolute;
      right: 0;
      bottom: -3rem;
      padding: 0 !important;
      text-align: end;
      color: var(--secondary-lighter-1);
      padding: 0;
      margin: 0;
  }

.text{
color: var(--secondary-dark-1);
text-align: center;
}

.card:hover{
    scale: 1.05;
    background-color: var(--secondary-dark-1);
    .text{
      color: white !important;
    }
    .number{
      color: var(--secondary-main-1);
    }
}
</style>
