 ---
const { title,imageUrl, content, icon: Icon, classname, href } = Astro.props;
import ArrowForwardIcon from "../../icons/arrow-forward-icon.astro";
---


 <div class=`card ${classname}`>
              
              <div class='image-container'>
                    <img 
                        class='image'
                        aria-hidden="true" 
                        loading="lazy"   
                        decoding="async" 
                        src={imageUrl} 
                        alt={title} 
                    />
                    <span class='icon-container'>
                         {Icon && <Icon class="card-icon" />}
                    </span>
                </div> 

                <div class='content-container'>
                    <p class='body1 text' style={{
                        fontWeight: '700',
                        textAlign: 'left'
                    }}>{title}</p>
                    <p class={'body2'} class='text' style={{
                        fontWeight: '450',
                        textAlign: 'left'
                    }}>{content}</p>
                </div>
        
               
                <a class='link' href={href}>
                    <ArrowForwardIcon/>
                </a>
                
        </div>

<style>
    .card{
  position: relative;
  width: min(100%, 400px);
  min-height: 400px;
  box-sizing: border-box;
  background-color: white;
  scale: 1;
  transition: scale .5s ease, background-color .5s ease, fill .5s ease;
  display: flex;
  flex-direction: column;
  cursor: pointer;
  align-items: flex-start;
  justify-content: center;
 
  gap: 1rem;
  
  
  
}
.image-container{
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 400px);
    height: 0;
    padding-bottom: 50%; /* 2 / 1 aspect ratio */
    position: relative;
}
.image{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.content-container{
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 1rem;
  width: 100%;
  flex-grow: 1;
  z-index: 10;
  
  padding: 10px;
}

.link{
  display: flex;
  align-items: center;
  justify-content: center;
      background-color: var(--secondary-lighter-1);
     width: 4rem;
     height: 2rem;
  }
.link > svg{
  fill: var(--secondary-dark-1);
}
.link:hover > svg{
  fill: var(--primary-main-1);
}
.text{
color: var(--secondary-dark-1);
text-align: center;

}

.card:hover{
    scale: 1.02;
  
}
.icon-container{
  position: absolute;
  width: 60px;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
  right: 30px;
  bottom: -30px;
  background-color: var(--primary-main-1);
}
.card-icon{
  fill: white;
  width: 36px;
  height: 36px;
}

</style>        