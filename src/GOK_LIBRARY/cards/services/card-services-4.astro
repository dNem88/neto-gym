---
const { service, content, classname, href } = Astro.props;
---

<a class=`card-resource ${classname}` href={href}>
  <div class="content-resource">
    <p
      class={"body1 text-resource"}
      style={{
        fontWeight: "700",
        textAlign: "center",
        lineHeight: "1.1",
        fontSize: "26px",
      }}>{service}</p
    >
    <p
      class="body1 content-text-resource"
      style={{
        fontWeight: "350",
        textAlign: "center",
        lineHeight: "1.1",
        color: "black",
      }}>{content}</p
    >
  </div>

  <span class="hover-span-resource"></span>
</a>

<style>
 .card-resource {
  position: relative;
  border-radius: 36px;
  width: min(100%, 350px);
  aspect-ratio: 1/1;
  box-sizing: border-box;
  background: linear-gradient(45deg, var(--primary-lighter-1) 10%, var(--secondary-light-1) 70%, var(--primary-lighter-1) 100%);
  scale: 1;
  transition: scale .5s ease, background .5s ease, fill .5s ease;
  display: flex;
  flex-direction: column;
  padding: 3.5rem;
  cursor: pointer;
  align-items: center;
  justify-content: center;
  box-shadow: 4px 4px 10px rgb(240, 240, 240);
  gap: 1rem;



}

.content-resource {
  display: flex;

  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2.5rem;
  width: 100%;
  flex-grow: 1;
  z-index: 10;
}

.link-resource {
  color: black;
  font-weight: 550;
  z-index: 10;
}

.text-resource {
  position: relative;
  color: black;
  text-align: center;
}

.text-resource::after {
  position: absolute;
  left: 50%;
  bottom: -10px;
  transform: translate(-50%,0);
  content: '';
  display: block;
  width: 40%;
  height: 1px;
  background: black;
}

.card-resource:hover {
  scale: 1.05;

  .hover-span-resource {
    height: 100%;
    transition: height .5s ease, width .5s ease;
  }

}

.hover-span-resource {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background: rgba(255, 255, 255, 0.781);
  z-index: 1;
  border-radius: 32px;
  transition: height .5s ease;
}
</style>
