---
const {title,content, imageUrl, classname, href} = Astro.props;
---
  
        <div class=`${'card23'} ${classname}`>
              
                <div class='content-container23'>
                    <p class='body1 text23' style={{
                        fontWeight: '700',
                        textAlign: 'center'
                    }}>{title}</p>
                    <span class='line'></span>
                    <p class='body2 content-text23' style={{
                        fontWeight: '450',
                        textAlign: 'center'
                    }}>{content}</p>
                </div>
        
                <div class='image-container23'>
                    <img
                        src={imageUrl}
                        alt={title}
                        loading="lazy"
                        style={{width: '100%',height: '100%', objectFit: 'cover'}}
                    />
                    <div class='filter23'/>
                </div>
                <a 
                    class='link23' 
                    href={href}>{'научете повече'}</a>
                
        </div>

<style>
    .card23{
  position: relative;
  border-radius: 32px;
  width: min(100%, 400px);
  min-height: 400px;
  box-sizing: border-box;
  background-color: white;
  scale: 1;
  transition: scale .5s ease, background-color .5s ease, fill .5s ease;
  display: flex;
  flex-direction: column;
  padding: 2rem;
  cursor: pointer;
  align-items: flex-start;
  justify-content: center;
  box-shadow: 4px 4px 10px rgb(221, 221, 221);
  gap: 1rem; 
}

.content-container23{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  width: 100%;
  flex-grow: 1;
  z-index: 10;
}

.link23{
  padding-left: 10px;
  font-size: 12px;
      color: white;
      font-weight: 550;
      z-index: 16;
  }
.link23:hover{
  text-decoration: underline;
}
.text23{
color: white;
text-align: center;
}
.line{
  width: 50px;
  height: 3px;
  background-color: var(--primary-main-1);
}
.content-text23{
  color:white;
}
.image-container23{
  position: absolute;
  overflow: hidden;
   border-radius: 32px;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
}
.filter23{
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, var(--secondary-dark-1) 50%, transparent 120%);
   border-radius: 32px;
  z-index: 1;
  border-radius: 32px;
  opacity: .85;
  transition: height .5s ease;
}
.card23:hover{
    scale: 1.05;
    transition: scale .25s ease;
  
}
</style>