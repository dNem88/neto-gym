---
const { title, classname, href, imageUrl } = Astro.props;
---

<a
  href={href}
  class={`card ${classname}`}
  style={{
    position: "relative",
    backgroundImage: `url(${imageUrl})`,
    backgroundSize: "cover",
    backgroundPosition: "center",
    backgroundRepeat: "no-repeat",
  }}
>
  <div class="title-container">
    <p
      class="h6 title10"
      style={{
        fontWeight: "550",
        color: "white",
        textAlign: "center",
      }}
    >
      {title?.toUpperCase()}
    </p>
  </div>
  <div class="filter10"></div>
</a>

<style>
  .card {
    position: relative;
    overflow: hidden;
    width: min(100%, 320px);
    aspect-ratio: 1/1.5;
    box-sizing: border-box;
    background-color: white;
    scale: 1;
    transition:
      scale 0.5s ease,
      background-color 0.5s ease,
      fill 0.5s ease;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    align-items: center;
    justify-content: space-between;
  }
   .filter10 {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(49, 49, 49, 0.247);
    z-index: 1;
    transition: background-color 0.5s ease;
  }
  .title-container {
    position: absolute;
    bottom: 0;
    left: 0;
   
    width: 100%;
    padding: 2rem;
    z-index: 3;
  }
  .title10 {
     position: relative;
    font-weight: 800;
    letter-spacing: -2px;
    z-index: 2;
  }
  .title10::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -15px;
    transform: translateX(-50%);
    width: 5rem;
    height: 2px;
    background-color: var(--primary-main-1, #fff);
  }
  .card:hover {
    scale: 1.05;
    .filter10 {
      background-color: #c8d30094;
    }
  }
</style>
