---
import { Image } from "astro:assets";
const { service, content, classname, href, imageUrl } = Astro.props;
---

<!-- Both options to pass the image are valid -->
<!-- imageUrl={card.imageUrl}
      imageUrl={Meeting} -->
<div class={`card16 ${classname}`}>
  <div class="image-container16">
    {
      imageUrl &&
        (typeof imageUrl === "string" ? (
          <img class="card-image" src={imageUrl} alt={service} loading="lazy" />
        ) : (
          <Image class="card-image" src={imageUrl} alt={service} />
        ))
    }
  </div>
  <div class="content-container16">
      <span class="line16"></span>
    <p class="body1 text16">{service}</p>
    <p class="body3 text16" style={{ fontWeight: "450", textAlign: "left" }}>
      {content}
    </p>
  </div>

  <a class="link16 body4" href={href}>{"научете повече"}</a>
</div>

<style>
  .card16 {
    position: relative;
    width: min(100%, 350px);
    min-height: 400px;
    box-sizing: border-box;
    background-color: white;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    align-items: flex-start;
    justify-content: center;
    box-shadow: 2px 2px 5px rgb(221, 221, 221);
    gap: 1rem;
    scale: 1;
    transition:
      scale 0.5s ease,
      background-color 0.5s ease,
      fill 0.5s ease;
  }
  .image-container16 {
    display: flex;
    align-items: center;
    width: 100%;
    aspect-ratio: 1 / 0.5;
    position: relative;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .line16 {
    width: 75px;
    height: 3px;
    position: absolute;
    left: 0;
    top: 0;
    background-color: var(--primary-main-1);
  }
  .content-container16 {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 1rem;
    width: 100%;
    flex-grow: 1;
    z-index: 10;
    padding: 1.5rem;
    padding-top: 10px;
  }

  
  .text16 {
      color: var(--secondary-dark-1);
      text-align: left;
      font-weight: 700;
    }
    
    .link16 {
      color: var(--primary-main-1);
      margin-bottom: 1.5rem;
      margin-left: 1.5rem;
    }
    .link16:hover{
        text-decoration: underline;
    }
  .card16:hover {
    scale: 1.02;
  }
</style>
