---
import CardTeam1 from './card-team-1.astro';
import CardTeam2 from './card-team-2.astro';
import CardTeam3 from './card-team-3.astro';
import CardTeam4 from './card-team-4.astro';
import CardTeam5 from './card-team-5.astro';
import CardTeam6 from './card-team-6.astro';
import Avatar from '../../../../assets/avatar.webp'


const card =  {
            avatarUrl: '/src/assets/avatar.webp',
            profession: 'Електротехник – Домашни и офис инсталации',
            name: 'Добромир Христов',
            bio: "Иван има над 12 години опит в ремонти, диагностика и изграждане на електрически системи. Известен е с прецизност и внимание към безопасността."
        }
---

<h4>ТЕАМ CARDS</h4>
<div class="cards-container-row" id="testimonials-cards">
     <div class="group">
     <h6>CARD 1</h6>
    <CardTeam1
      name={card.name}
      profession={card.profession}
      bio={card.bio}
      avatarUrl={Avatar}
    />
  </div>
  <div class="group">
    <h6>CARD 2</h6>
     <CardTeam2
      name={card.name}
      profession={card.profession}
      bio={card.bio}
      avatarUrl={Avatar}
    />
  </div>
    <div class="group">
     <h6>CARD 3</h6>
     <CardTeam3
      name={card.name}
      profession={card.profession}
      bio={card.bio}
      avatarUrl={Avatar}
    />
  </div>
  
  <div class="group">
    <h6>CARD 4</h6>
     <CardTeam4
      name={card.name}
      profession={card.profession}
      bio={card.bio}
      avatarUrl={Avatar}
    />
  </div>
   <div class="group">
     <h6>CARD 5</h6>
     <CardTeam5
      name={card.name}
      profession={card.profession}
      bio={card.bio}
      avatarUrl={Avatar}
    />
  </div>
  <div class="group">
      <h6>CARD 6</h6>
    <CardTeam6
      name={card.name}
      profession={card.profession}
      bio={card.bio}
      avatarUrl={Avatar}
    />
  </div>
  <div class="group">
      <h6>CARD 7</h6>
  
  </div>
    <div class="group">
          <h6>CARD 8</h6>
   
  </div>
   <div class="group">
    
  </div>
</div>

<style>
  .cards-container-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    position: absolute;
    top: 3rem;
    left: 0;
    border: 2px dashed black;
    overflow-x: scroll;
  }
  .group {
    display: flex;
    padding: 1.5rem;
    width: 450px;
    gap: 1rem;
    flex-direction: column;
  }
  .icon {
    position: relative;
    width: 15px;
    height: 15px;
    fill: white;
    z-index: 10;
  }
</style>
