---
const { post } = Astro.props;
let { publishedAt, title, mainImageUrl, author, excerpt, slug } = post;
import { Image } from "astro:assets";

---

<div class="card">
  {
    mainImageUrl && (
      typeof mainImageUrl === "string" ? (
        <img src={mainImageUrl} alt={title} class="main-image" loading="lazy" />
      ) : (
        /* Ensure src is the object itself */
        <Image src={mainImageUrl} alt={title} class="main-image" />
      )
    )
  }
 
  <div class="text-content">
    <div class="meta-container">
      <span class="meta-item">{publishedAt?.split("T")[0]}</span>
      <span class="meta-divider">•</span>
      <span class="meta-item">от {author || 'Екип'}</span>
    </div>

    <h3 class="title-text">{title}</h3>
    
    {excerpt && <p class="excerpt-text">{excerpt}</p>}
  </div>

  <div class="card-footer">
    <a href={slug ? `/blog/${slug}` : "/slug-to-blog-post"} class="link">
      Прочетете повече <span>→</span>
    </a>
  </div>
</div>


<style>
  .card {
    display: flex;
    flex-direction: column;
    width: min(100%, 330px);
    /* Remove fixed aspect-ratio to let content dictate height, 
       or use min-height for consistency */
    min-height: 400px; 
    border-radius: 16px; /* Slightly more professional than 24px */
    background-color: white;
    overflow: hidden;
    /* Soft, multi-layered shadow */
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), 
                box-shadow 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .main-image {
    width: 100%;
    aspect-ratio: 16 / 9; /* Professional standard for blog headers */
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .text-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem; /* Better spacing between meta and title */
    flex-grow: 1;
  }

  /* --- Hierarchy Level 3: Meta Data (Smallest/Lightest) --- */
  .meta-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8; /* Muted Slate */
  }

  .meta-divider {
    color: #cbd5e1;
  }

  /* --- Hierarchy Level 1: The Title (Strongest) --- */
  .title-text {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: #0f172a; /* Deep Navy/Black */
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* --- Hierarchy Level 2: The Excerpt (Intermediate) --- */
  .excerpt-text {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* --- Hierarchy Level 4: The Call to Action --- */
  .card-footer {
    padding: 0 1.5rem 1.5rem;
  }

  .link {
    color: var(--secondary-main-1);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    transition: gap 0.3s ease;
  }

  .link span {
    transition: transform 0.3s ease;
    display: inline-block;
  }

  /* --- Interactions --- */
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1);
  }

  .card:hover .link span {
    transform: translateX(4px); /* Interactive arrow movement */
  }
</style>