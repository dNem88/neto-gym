---
const { name, age, city, testimonial, avatarUrl } = Astro.props;
// Use the standard Astro Image component
import { Image } from "astro:assets";
import StarIcon from "../../icons/star-icon.astro";
import QuotesColseIcon from "../../icons/quotes-colse-icon.astro";
---

<div class="card">
  <div class="quotes-bg">
    <QuotesColseIcon class="quote-icon" />
  </div>

  <div class="customer-container">
    <div class="avatar-wrapper">
      {
        avatarUrl &&
          (typeof avatarUrl === "string" ? (
            <img class="card-image" src={avatarUrl} alt={name} loading="lazy" />
          ) : (
            <Image class="card-image" src={avatarUrl} alt={name} />
          ))
      }
    </div>
    
    <div class="customer-data">
      <p class="customer-name">{name}</p>
      <p class="customer-location">{`${age}, ${city}`}</p>
    </div>
  </div>

  <div class="testimonial-content">
    <p class="testimonial-text">
      {testimonial ? `"${testimonial}"` : "Изключително професионално отношение и грижа!"}
    </p>
    
    <div class="stars-container">
      {[...Array(5)].map((_, i) => <StarIcon key={i} class="star" />)}
    </div>
  </div>
</div>

<style>
  .card {
    position: relative;
    width: min(100%, 380px); /* Slightly wider for better text flow */
    padding: 2.5rem 2rem;
    background: white;
    border-radius: 12px; /* Softer corners */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05); /* Softer, modern shadow */
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    overflow: hidden;
  }

  .card:hover {
    transform: translateY(-10px);
    cursor: pointer;
  }

  .customer-container {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #f0f0f0;
  }

  .avatar-wrapper {
    width: 65px; /* Slightly smaller looks more elegant */
    height: 65px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--secondary-lighter-1);
    transition: transform 0.5s ease;
  }

  .card:hover .avatar-wrapper {
    transform: scale(1.1) rotate(5deg);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .customer-data {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* Left aligned looks more professional here */
    text-align: left;
  }

  .customer-name {
    font-weight: 700;
    color: var(--secondary-dark-1);
    font-size: 1.1rem;
    margin: 0;
  }

  .customer-location {
    font-size: 0.85rem;
    color: #888;
    margin: 0;
  }

  .testimonial-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .testimonial-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--secondary-dark-1);
    font-style: italic;
    text-align: center;
    margin: 0;
  }

  .stars-container {
    display: flex;
    gap: 2px;
  }

  .star {
    fill: #ffc107;
    width: 20px; /* Smaller stars look more sophisticated */
    height: 20px;
  }

  /* Decorative Quote */
  .quotes-bg {
    position: absolute;
    top: 10px;
    right: 20px;
    opacity: 0.1;
  }

  .quote-icon {
    width: 60px;
    height: 60px;
    fill: var(--secondary-dark-1);
  }
</style>