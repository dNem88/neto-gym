---
const { name, age, city, testimonial, avatarUrl } = Astro.props;
// Use the standard Astro Image component
import { Image } from "astro:assets";
import StarIcon from "../../icons/star-icon.astro";
import QuotesColseIcon from "../../icons/quotes-colse-icon.astro";
---
<div class="card">
      <div class="triangle" />
      <div class="customer-container">
            {
                avatarUrl &&
                (typeof avatarUrl === "string" ? (
                    <img class="avatar" src={avatarUrl} alt={name} loading="lazy" />
                ) : (
                    <Image class="avatar" src={avatarUrl} alt={name} />
                ))
            }
        <div class="content">
          <p
            class={"body2"}
            style={{ fontWeight: "550", color: "white", textAlign: "center" }}
          >
            {name}
        </p>
          <p
            class={"body2"}
            style={{ color: "var(--secondary-lighter-1)", textAlign: "center" }}
          >{`${age}, ${city}`}</P>
        </div>
      </div>

      <div class="quotes-container">
        <QuotesColseIcon class="quotes" />
        <p
          class={"body3"}
          style={{
            color: "white",
            textAlign: "center",
            fontStyle: 'italic',
            flexGrow: "1",
          }}
        >
          {`"${testimonial}"` ||
            '"Клиниката предостави изключителна грижа и професионализъм. Персоналът беше приветлив, внимателен и ме накара да се чувствам удобно през целия ми престой. Горещо препоръчвам техните услуги за качествено здравеопазване."'}
        </p>
        <QuotesColseIcon class="quotes-end" />
      </div>

      <div class="stars-container">
        {[...Array(5)].map((_, index) => (
          <StarIcon  class="star" />
        ))}
      </div>
    </div>


<style>
    .card{
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    background-color: var(--secondary-dark-1);
    width: min(100%, 375px);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    scale: 1;
    transition: scale .5s ease;
    gap: 8px;
    cursor: pointer;
    box-shadow: 2px 2px 5px rgb(219, 219, 219);
}
.card:hover{
    scale: 1.05;  
}
.triangle{
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 6rem;
    background-color: var(--primary-main-1);
    clip-path: polygon(0% 0, 100% 0 , 100% 100%);
    z-index: 1;
    opacity: .45;
}
.customer-container{
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1rem;
    z-index: 5;
    .avatar{
        width: 90px;
        height: 90px;
        border-radius: 50%;
        border: 4px solid var(--secondary-light-1);
        object-fit: cover;
    }
    .content{
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
}
@media screen and (min-width: 900px) {
    .customer-container{
        flex-direction: row;
        gap: 2rem;
        
    }
    
}
.quotes-container{
    width: 100%;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.stars-container{
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}
.star{
    fill: var(--primary-light-1);
    width: 36px;
    height: 36px;
}
.quotes{
    fill: var(--secondary-main-1);
    width: 54px;
    height: 54px;
    
}
.quotes-end{
    fill: var(--secondary-main-1);
    width: 54px;
    height: 54px;
    align-self: flex-end;
}
</style>