---
import CardTestimonials1 from "./card-testimonials-1.astro";
import CardTestimonials2 from "./card-testimonials-2.astro";
import CardTestimonials3 from "./card-testimonials-3.astro";
import CardTestimonials4 from "./card-testimonials-4.astro";
import CardTestimonials5 from "./card-testimonials-5.astro";
import CardTestimonials6 from "./card-testimonials-6.astro";
import CardTestimonials7 from "./card-testimonials-7.astro";
import CardTestimonials8 from "./card-testimonials-8.astro";
import Avatar from '../../../../assets/avatar.webp'

const card = {
            name: 'Александър Петков',
            age: '48',
            avatarUrl: '/src/assets/avatar.webp',
            city: 'Плевен',
            testimonial: "Отлично обслужване! Специалистите от Team Electric ми помогнаха с подмяна на ел. таблото и направиха всичко по най-сигурния начин. Обясниха ясно какво трябва да се извърши и работиха бързо и качествено."
        };
// console.log(Meeting);
---

<h4>TESTIMONIALS CARDS</h4>
<div class="cards-container-row" id="testimonials-cards">
     <div class="group">
     <h6>CARD 1</h6>
    <CardTestimonials1
      name={card.name}
      age={card.age}
      city={card.city}
      avatarUrl={Avatar}
      testimonial={card.testimonial}
    />
  </div>
  <div class="group">
    <h6>CARD 2</h6>
    <CardTestimonials2
      name={card.name}
      age={card.age}
      city={card.city}
      avatarUrl={Avatar}
      testimonial={card.testimonial}
    />
  </div>
    <div class="group">
