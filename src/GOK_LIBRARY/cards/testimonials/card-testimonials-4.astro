---
const { name, age, city, testimonial, avatarUrl } = Astro.props;
import { Image } from "astro:assets";
import StarIcon from "../../icons/star-icon.astro";
---

<div class="card">
  <div class="customer-container">
    <div class="avatar-holder">
      {
        avatarUrl &&
          (typeof avatarUrl === "string" ? (
            <img class="card-image" src={avatarUrl} alt={name} loading="lazy" />
          ) : (
            <Image class="card-image" src={avatarUrl} alt={name} />
          ))
      }
    </div>
    
    <p class="customer-name">{name}</p>
    <p class="customer-location">{`${age}, ${city}`}</p>
  </div>

  <div class="testimonial-content">
    <p class="testimonial-text">
      {testimonial}
    </p>
    
    <div class="stars-container">
      {[...Array(5)].map((_, index) => <StarIcon key={index} class="star" />)}
    </div>
  </div>
</div>

<style>
  .card {
    width: min(100%, 350px);
    border-radius: 12px; /* Increased for a softer, modern look */
    padding: 2.5rem 1.5rem;
    background: white;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05); /* Softer medical-style shadow */
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    cursor: pointer;
  }

  .customer-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #f0f0f0;
    margin-bottom: 1.5rem;
  }

  .avatar-holder {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--secondary-lighter-1);
    margin-bottom: 0.5rem;
    transition: transform 0.5s ease;
  }

  .card:hover .avatar-holder {
    transform: scale(1.1) rotate(5deg);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .customer-name {
    font-weight: 700;
    color: var(--secondary-dark-1);
    margin: 0;
    font-size: 1.1rem;
  }

  .customer-location {
    font-size: 0.85rem;
    color: #888;
    margin: 0;
  }

  .testimonial-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .testimonial-text {
    color: var(--secondary-dark-1);
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.6;
    font-style: italic;
    margin: 0;
  }

  .stars-container {
    display: flex;
    gap: 4px;
  }

  .star {
    fill: #FBBC05;
    width: 24px; /* Slightly smaller stars feel more balanced */
    height: 24px;
  }
</style>