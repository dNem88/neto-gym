---
const { name, age, city, avatarUrl, testimonial } = Astro.props;
import QuotesColseIcon from "../../icons/quotes-colse-icon.astro";
import StarIcon from "../../icons/star-icon.astro";
import GoogleReviewIcon from "../../icons/google-review-icon.astro";
---

<div class="card2">
  <div class="header-container-2">
    <div class="stars-container2">
      <slot name="stars">
        {[...Array(5)].map((_, index) => <StarIcon key={index} class="star" />)}
      </slot>
    </div>
    <QuotesColseIcon class="quotes" />
    <p
      class="body3 testimonial-text"
     
    >
      {
        `"${testimonial}"` ||
          '"Клиниката предостави изключителна грижа и професионализъм. Персоналът беше приветлив, внимателен и ме накара да се чувствам удобно през целия ми престой. Горещо препоръчвам техните услуги за качествено здравеопазване."'
      }
    </p>
  </div>
  <div class="customer-container2">
    <GoogleReviewIcon class="icon" />

    <div>
      <p class="body3" style={{ fontWeight: "550", color: "white" }}>
        {name}
      </p>
      <p class="caption" style={{ color: "white" }}>{`${age}, ${city}`}</p>
    </div>
  </div>
</div>

<style>
  .card2 {
    display: flex;
    flex-direction: column;
    background: linear-gradient(
      -45deg,
      var(--secondary-dark-1) 50%,
      var(--secondary-light-1) 120%
    );
    scale: 1;
    transition: scale 0.5s ease;
    padding: 1rem;
    aspect-ratio: 1 / 1;
    width: min(100%, 320px);
    border-radius: 16px;
    justify-content: space-evenly;
  }

  .card2:hover {
    scale: 1.05;
    cursor: pointer;
  }
  .header-container-2 {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    flex-grow: 1;
    padding: 1rem;
    gap: 1rem;
    flex-grow: 1;
  }
  .star {
    fill: var(--primary-main-1);
    width: 36px;
    height: 36px;
  }
  .testimonial-text{
    color: white;
    text-align: center;
    font-style: italic;
  }
  .quotes {
    position: absolute;
    bottom: -2rem;
    right: 0;
    fill: var(--primary-main-1);
    width: 48px;
    height: 48px;
  }
  .customer-container2 {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    margin-top: 3rem;
    align-self: flex-end;
    justify-self: flex-end;
  }
  .customer-container2 > div {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    flex-grow: 1;
   
   
  }
  .icon {
    width: 36px;
    height: 36px;
  }
</style>
