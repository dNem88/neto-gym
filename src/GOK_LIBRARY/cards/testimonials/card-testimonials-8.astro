---
const { name, age, city, testimonial, avatarUrl } = Astro.props;
import { Image } from "astro:assets";
import StarIcon from "../../icons/star-icon.astro";
---

<div class="card">
  <div class="customer-container">
    <div class="avatar-holder">
      {
        avatarUrl &&
          (typeof avatarUrl === "string" ? (
            <img class="avatar" src={avatarUrl} alt={name} loading="lazy" />
          ) : (
            <Image class="avatar" src={avatarUrl} alt={name} />
          ))
      }
    </div>

    <p class="customer-name">{name}</p>
    <p class="customer-location">{`${age}, ${city}`}</p>
  </div>
  <div class="testimonial-content">
    <p class="testimonial-text">
      {
        testimonial
          ? `"${testimonial}"`
          : `"Изключително професионално отношение и грижа!"`
      }
    </p>
    <div class="stars-container">
      {[...Array(5)].map((_, index) => <StarIcon key={index} class="star" />)}
    </div>

  </div>
  <div class="polygon"/>
</div>
<style>
  .card {
    width: min(100%, 350px);
    border-radius: 16px; /* Slightly rounder for a friendlier feel */
    padding: 2.5rem; /* Increased padding gives it a 'boutique' feel */
    background: white;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
   
  }

  .customer-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* This gap controls the space between Avatar, Name, and Location */
    gap: 0.25rem;
    margin-bottom: 1.25rem; /* Space before the stars */
  }

  .avatar-holder {
    width: 85px; /* Slightly smaller avatar creates a more elegant profile */
    height: 85px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--secondary-lighter-1);
    margin-bottom: 0.75rem; /* Extra breathing room below the photo */
    z-index: 5;
  }
  .avatar {
    width: 100%;
   height: 100%;
   border: 4px solid var(--secondary-light-1);
   object-fit: cover;
   border-radius: 50%;
   z-index: 10;
  }
  .customer-name {
    font-weight: 700;
    color: var(--secondary-dark-1);
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.01em; /* Tighter tracking for bold titles */
  }

  .customer-location {
    font-size: 0.85rem;
    color: #94a3b8; /* Using a cool-toned slate gray for medical themes */
    margin: 0;
    text-transform: uppercase; /* Optional: adds a 'data' feel */
    letter-spacing: 0.05em;
  }

  .stars-container {
    display: flex;
    gap: 2px;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    margin-bottom: 1.5rem; /* Significant gap before the text begins */
  }

  .star {
    fill: #ffb800; /* A slightly more premium 'Goldenrod' yellow */
    width: 18px; /* Smaller stars look much more sophisticated */
    height: 18px;
  }

  .testimonial-content {
    width: 100%;
    border-top: 1px solid #f1f5f9; /* Subtle divider adds structural quality */
    padding-top: 1.5rem;
  }

  .testimonial-text {
    color: var(--secondary-dark-1);
    text-align: center;
    font-size: 1rem;
    line-height: 1.7; /* Increased line-height for readability */
    font-style: italic;
    opacity: 0.9;
  }
  .polygon{
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 115px;
    clip-path: polygon(0% 0%, 100% 0%, 100% 40%, 0% 100%);
    background-color: var(--secondary-dark-1);
    z-index: 1;
} 
</style>
