---
const { name, age, city, testimonial } = Astro.props;
import QuotesColseIcon from "../../icons/quotes-colse-icon.astro";
import StarIcon from "../../icons/star-icon.astro";
import GoogleReviewIcon from "../../icons/google-review-icon.astro";

---

<div class="card">
  <div class="header-container">
    <div class="stars-container">
      <slot name="stars">
        {[...Array(5)].map((_, index) => <StarIcon key={index} class="star" />)}
      </slot>
    </div>
    
    <div class="testimonial-wrapper">
       <p class="body2 testimonial-text">"{testimonial}"</p>
       <QuotesColseIcon class="quotes-icon" />
    </div>
  </div>

  <div class="footer-container">
    <div class="google-icon-wrapper">
       <GoogleReviewIcon class="google-icon" />
    </div>

    <div class="customer-info">
      <p class="name">{name}</p>
      <p class="meta">{`${age}, ${city}`}</p>
    </div>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: white;
    padding: 2rem;
    aspect-ratio: 1 / 1.2;
    width: min(100%, 350px);
    border-radius: 20px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    border: 1px solid #f0f0f0;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    cursor: pointer;
  }

  .header-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    gap: 1rem;
    text-align: center;
    position: relative;
  }

  .star {
    fill: #FBBC05;
    width: 24px; /* Scaled down for 1:1 ratio balance */
    height: 24px;
  }

  .testimonial-wrapper {
    position: relative;
    width: 100%;
  }

  .testimonial-text {
    color: #444;
    font-style: italic;
  }

  .quotes-icon {
    position: absolute;
    bottom: -40px;
    right: -5px;
    fill: #eee;
    width: 40px;
    height: 40px;
    z-index: 0;
  }

  .footer-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid #f5f5f5;
  }

  .google-icon {
    width: 32px;
    height: 32px;
  }

  .customer-info {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .name {
    font-weight: 600;
    font-size: 0.95rem;
    margin: 0;
    color: var(--secondary-dark-1);
  }

  .meta {
    font-size: 0.8rem;
    margin: 0;
    color: #888;
  }
</style>