---
const { name, age, city, testimonial, avatarUrl } = Astro.props;
import Image from "astro/components/Image.astro";
import QuotesColseIcon from "../../icons/quotes-colse-icon.astro";
import Quote from "../../icons/quote.astro";
---

<div class="card">
  <div class="customer-container">
    {
      avatarUrl &&
        (typeof avatarUrl === "string" ? (
          <img class="card-image" src={avatarUrl} alt={name} loading="lazy" />
        ) : (
          <Image class="card-image" src={avatarUrl} alt={name} />
        ))
    }
    <p
      class={"body1"}
      style={{
        fontWeight: "650",
        color: "var(--secondary-dark-1)",
      }}
    >
      {name}
    </p>
    <p
      class={"caption"}
      style={{
        color: "var(--secondary-dark-1)",
      }}
    >
      {`${age}, ${city}`}
    </p>
  </div>
  <div class="testimonial-text-container">
    <div >
      <QuotesColseIcon width={60} height={35} fill="var(--primary-main-1)"/>
    </div>
    <p
      class={"body3"}
      style={{
        color: "var(--secondary-dark-1)",
        textAlign: "center",
      }}
    >
      {
        `"${testimonial}"` ||
          '"Клиниката предостави изключителна грижа и професионализъм. Персоналът беше приветлив, внимателен и ме накара да се чувствам удобно през целия ми престой. Горещо препоръчвам техните услуги за качествено здравеопазване."'
      }
    </p>
  </div>
</div>

<style>
  .card {
    width: min(100%, 350px);
    border-radius: 4px;
    padding: 2rem;
    background: white;
    box-shadow: 2px 2px 10px rgb(201, 201, 201);
    scale: 1;
    transition: scale 0.5s ease;
  }
  .card:hover .testimonial-avatar {
    transform: rotate(5deg);
    overflow: hidden;
    scale: 1.1;
    transition:
      transform 0.5s ease,
      scale 0.5s ease;
  }
  .card:hover {
    scale: 1.05;
    cursor: pointer;
  }
  .card-image{
    width: 80px;
    height: 80px;
    border-radius: 50%;
  }
  .customer-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    border-bottom: 1px solid var(--secondary-lighter-1);
  }
  .testimonial-text-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
