---
import LayoutMain from "@/src/layouts/LayoutMain.astro";
import Header from "./_components/HeaderTemplate10/Header.astro";
import LayoutUsluga from "./_components/Layout-Usluga.astro";
import { SingleServiceContent } from "./contentSingleServicePage";
import ListItem from "./_components/list-item.astro";
---

<LayoutMain color="gym1">
  <Header slot="header" />
  <LayoutUsluga 
        title={SingleServiceContent.title}
        breadcrumb={`начало | услуги | ${SingleServiceContent.title}`}
        slot="main">
     <Fragment slot="content">
         
       <p class={'body2'}>{SingleServiceContent.serviceDescriptionContent[0]}</p>
       <p class={'body2'}>{SingleServiceContent.serviceDescriptionContent[1]}</p>
       <div>
         {SingleServiceContent.benefitsList.map((listItem, idx) => (
           <ListItem 
           iconStyle={{fill: 'var(--primary-main-1)'}}>{listItem}</ListItem>
          ))}
          </div>
          <img
            src={SingleServiceContent.imageUrl}
            alt={SingleServiceContent.title}
            loading="lazy"
            style={{
              width: '100%',
              height: '300px',
              objectFit: 'cover'
            }}
          />
          
          <p class={'body2'}>{SingleServiceContent.serviceDescriptionContent[2]}</p>
          <p class={'body2'}>{SingleServiceContent.serviceDescriptionContent[3]}</p>
          <p class={'body2'}>{SingleServiceContent.serviceDescriptionContent[4]}</p>
        </Fragment>
  </LayoutUsluga>
</LayoutMain>

<style>
    :global(.gym1) {
    --primary-dark-1: #9a9500;
    --primary-main-1: #C7D300;
    --primary-light-1: #e5e990;
    --primary-lighter-1: #f9fae4;
    --secondary-dark-1: #0A0A0A;
    --secondary-main-1: #2c2c2c;
    --secondary-light-1: #cacaca;
    --secondary-lighter-1: #f6f6f6;
  }
</style>
