---
import TitleTemplate10 from "../title-template-10.astro";

const { title, breadcrumb } = Astro.props;

---

<div class="main">
  <section class="hero10">
      <div class="filter"></div>
      <div class="polygon"></div>
      <TitleTemplate10 title={title} variant="light" align="center"/>
      <p class="body1 breadcrumb">{breadcrumb}</p>
   
  </section>
</div>

<style>
  .main {
    width: 100vw;
    display: flex;
    align-items: center;
    flex-direction: column;
    padding-top: 3.5rem;
   
  }
  @media screen and (min-width: 1200px) {
    .main {
      padding-top: 4.5rem;
    }
  }

.hero10{
    position: relative;
    display: flex;
    padding:  5rem 1rem;
    width: 100vw;
    height: 400px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
     background-image: url('/template10/gym3.webp');
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    border-radius: 1rem;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}
@media screen and (min-width: 1200px){
    .hero10{
        /* padding: 4.5rem 20rem; */
    }
    
}


.filter{
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background: linear-gradient(45deg, var(--secondary-dark-1) 25%, transparent 120%);

}
.polygon{
    width: 100px;
    height: 100%;
    position: absolute;
   
    left: 0;
    top: 0;
    z-index: 10;
    clip-path: polygon(0% 0%, 100% 0%, 20% 100%, 0% 100%);
    background-image: url('/template10/dots.svg');
    background-repeat: no-repeat;
    background-size: cover;
}
@media screen and (min-width: 1200px){
    .polygon{
        width: 350px;
    }
    
}
.title{
    color: white !important;
    padding-bottom: 2rem;
    z-index: 10;
}
.breadcrumb{
  color: var(--primary-main-1);
  z-index: 1;
}
</style>
