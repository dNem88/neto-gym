---
import Button5 from "@/src/GOK_LIBRARY/buttons/button5.astro";
import TitleTemplate10 from "../title-template-10.astro";
---

<section class="wrapper-t4-cta">
  <TitleTemplate10
    title={'Запазете си час с треньор още сега!'}
    variant="dark"
    align="left"
    
  />

  <Button5
    width={'20em'}
    variant={"black"}
    content={"Запазете консултация"}
    href={"/kontakti"}
  />
</section>

<style>
  :global(.wrapper-t4-cta){
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    padding: 5rem 16px;
    background-color: var(--primary-main-1);
    gap: 4rem;
    
}

@media screen and (min-width: 1200px){
    :global(.wrapper-t4-cta){
        flex-wrap: nowrap;
        justify-content: space-between;
        padding: 5rem 15rem;
       
       
    }
   
    
}
</style>
