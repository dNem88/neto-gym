---

import MenuIcon from "@/src/GOK_LIBRARY/icons/menu-icon.astro";
import CloseIcon from "@/src/GOK_LIBRARY/icons/close-icon.astro";

const links = [
    {label: 'Начало',href: '/'},
    {label: 'Услуги',href: '/uslugi',sublinks: [
        {label: 'фитнес тренировки',href: '/uslugi/fitnes-trenirovki'},
        {label: 'персонални тренировки',href: '/uslugi/personalni-trenirovki'},
        {label: 'функционални тренировки',href: '/uslugi/funkcionalni-trenirovki'},
        {label: 'групови тренировки',href: '/uslugi/grupovi-trenirovki'},
        {label: 'онлайн програми',href: '/uslugi/onlain-programi'},
        {label: 'консултации по хранене',href: '/uslugi/konsultacii-po-hranene'},
    ]},
   
    {label: 'За нас',href: '/za-nas'},
    {label: 'Блог',href: '/blog'},
     {label: 'Контакти',href: '/kontakti'},
    
 ]
---

<button id="menu-open" class="non-active-menu" aria-label="Отвори менюто">
  <MenuIcon class="menu"/>
</button>

<div id="mobile-nav" class="absolute-navigation">
  <div class="full-width-icon-box">
    <button id="menu-close" style="background:none; border:none; cursor:pointer; padding: 16px;" aria-label="Затвори менюто">
      <CloseIcon class="close"/>
    </button>
  </div>

  <div class="links-container">
    {links.map((link) => (
      link.sublinks ? (
        <div class="mobile-dropdown">
          <div class="dropdown-header">
            <a href={link.href} class="nav-link">{link.label}</a>
            <button class="dropdown-toggle" aria-label="Разгъни">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
          </div>
          <div class="mobile-sublinks">
            {link.sublinks.map((sub) => (
              <a href={sub.href} class="sub-link">{sub.label}</a>
            ))}
          </div>
        </div>
      ) : (
        <a href={link.href} class="nav-link">{link.label}</a>
      )
    ))}
   
  </div>
</div>
<script>
  const menuOpen = document.getElementById('menu-open');
  const menuClose = document.getElementById('menu-close');
  const mobileNav = document.getElementById('mobile-nav');
  const dropdownToggles = document.querySelectorAll('.dropdown-toggle');

  function toggleMenu() {
    mobileNav?.classList.toggle('active');
    document.body.style.overflow = mobileNav?.classList.contains('active') ? 'hidden' : '';
  }

  menuOpen?.addEventListener('click', toggleMenu);
  menuClose?.addEventListener('click', toggleMenu);

  // Accordion Logic
  dropdownToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const parent = toggle.closest('.mobile-dropdown');
      parent?.classList.toggle('is-open');
    });
  });
</script>
<style>
  /* Keep your existing .non-active-menu and .absolute-navigation styles */
  .non-active-menu {
    display: flex; align-items: center; justify-content: center;
    width: 3.5rem; height: 3.5rem; background: none; border: none; cursor: pointer;
  }

  .absolute-navigation {
    position: fixed; top: 0; left: 0; display: flex; flex-direction: column;
    width: 100vw; height: 100vh; background-color: var(--secondary-dark-1); z-index: 100;
    transform: translateY(-100%);
    transition: transform 0.4s cubic-bezier(0.77, 0.2, 0.05, 1.0);
    overflow-y: auto; /* Allow scrolling if list is long */
  }

  .absolute-navigation.active { transform: translateY(0); }

  .links-container {
    width: 100%; display: flex; flex-direction: column;
    padding: 0 2rem 4rem 2rem; gap: 1rem;
  }

  /* Dropdown Styles */
  .mobile-dropdown {
    width: 100%;
    border-bottom: 1px solid ;
    padding-bottom: 0.5rem;
  }

  .dropdown-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dropdown-toggle {
    background: #f5f5f5;
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .mobile-dropdown.is-open .dropdown-toggle {
    transform: rotate(180deg);
    background: var(--primary-main-1, #007bff);
    color: var(--secondary-dark-1);
  }

  /* Sublinks Hidden State */
  .mobile-sublinks {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
    display: flex;
    flex-direction: column;
    padding-left: 1rem;
    
  }

  .mobile-dropdown.is-open .mobile-sublinks {
    max-height: 500px; /* Large enough for content */
    margin-top: 1rem;
  }

  .nav-link {
    font-size: 1.35rem;
    text-decoration: none;
    color: white;
    font-weight: 300;
    text-transform: capitalize;
  }

  .sub-link {
    font-size: 1.1rem;
    text-decoration: none;
   color: rgb(230, 230, 230);
    padding: 0.6rem 0;
    border-left: 2px solid var(--secondary-main-1);
    padding-left: 1rem;
  }
  .menu{
    width: 32px;
    height: 32px;
    fill: black;
  }
   .close{
    width: 32px;
    height: 32px;
    fill: var(--primary-main-1);
   
  }
  .menu:hover{
    fill: rgb(59, 59, 59);
  }
  @media screen and (min-width: 1200px) {
    .non-active-menu, .absolute-navigation { display: none !important; }
  }
</style>