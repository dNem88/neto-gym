---
const { href, label } = Astro.props;
---

<div class='aside-service-container'>
  <a href={href} class="aside-service-text">
    {label}
  </a>
</div>

<style>
  .aside-service-container {
    width: 100%;
    display: flex;
    border-radius: 12px;
    padding: 0.5rem 1rem;
    background-color: white;
    align-items: center;
    justify-content: center;
  }
  .aside-service-text {
    color: var(--secondary-dark-1);
    color: black;
  
  }
  .aside-service-text:hover {
    text-decoration: underline;
    text-decoration-color: var(--secondary-dark-1);
  }
</style>
