<style>
     :global(.gym1) {
    --primary-dark-1: #9a9500;
    --primary-main-1: #C7D300;
    --primary-light-1: #e5e990;
    --primary-lighter-1: #f9fae4;
    --secondary-dark-1: #0A0A0A;
    --secondary-main-1: #2c2c2c;
    --secondary-light-1: #cacaca;
    --secondary-lighter-1: #f6f6f6;
  }
 
}
  .iframe-wrapper {
    width: 100vw;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .maps-section {
    width: 100vw;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1rem;
  }
  .map-container {
    width: min(100%, 1200px);
    aspect-ratio: 1/1;
  }
  @media screen and (min-width: 1200px) {
    .map-container {
      width: min(100%, 1200px);
      aspect-ratio: 2 / 0.75;
    }
  }
</style>
